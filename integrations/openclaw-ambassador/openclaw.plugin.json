{
  "id": "embassys-ambassador",
  "name": "Embassys Ambassador",
  "description": "Accepts authenticated Ambassador webhooks and starts an OpenClaw model turn.",
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "$defs": {
      "secretRef": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source": {
            "type": "string",
            "enum": ["env", "file", "exec", "store"]
          },
          "provider": {
            "type": "string"
          },
          "id": {
            "type": "string"
          }
        },
        "required": ["source", "provider", "id"]
      },
      "secretInput": {
        "anyOf": [
          {
            "type": "string",
            "pattern": "^[a-f0-9]{48}$"
          },
          {
            "$ref": "#/$defs/secretRef"
          }
        ]
      }
    },
    "properties": {
      "secret": {
        "$ref": "#/$defs/secretInput"
      },
      "agentId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "additionalProperties": false
  },
  "configContracts": {
    "secretInputs": {
      "paths": [
        {
          "path": "secret",
          "expected": "string",
          "ownerKind": "route"
        }
      ]
    }
  },
  "uiHints": {
    "secret": {
      "label": "Ambassador webhook secret",
      "sensitive": true
    },
    "agentId": {
      "label": "OpenClaw agent ID",
      "placeholder": "main"
    }
  }
}
