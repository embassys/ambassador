{
  "name": "@a2adev/gateway",
  "version": "0.2.5",
  "description": "Local A2A gateway for waking AI agent runtimes",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nikrooz/a2a.git"
  },
  "files": [
    "dist",
    "docs/hermes-webhook-bridge.mjs",
    "docs/getting-started-hermes.md",
    "docs/getting-started-openclaw.md",
    "docs/live-e2e-openclaw-hermes.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "a2a-gateway": "dist/cli.js"
  },
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "pnpm run lint && pnpm run typecheck && pnpm test",
    "clean": "node scripts/clean.mjs",
    "format": "biome check --write .",
    "lint": "biome check .",
    "prepack": "pnpm run build",
    "test": "pnpm run test:build && node scripts/run-tests.mjs",
    "test:build": "node scripts/clean.mjs .test-dist && tsc -p tsconfig.test.json",
    "test:coverage": "pnpm run test:build && node scripts/run-tests.mjs --coverage",
    "typecheck": "tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "better-sqlite3": "13.0.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.13.3",
    "typescript": "7.0.2"
  }
}
